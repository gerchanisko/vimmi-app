{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vimmi Beta",
  "mainBinaryName": "vimmi-beta",
  "version": "0.8.0-beta.1",
  "identifier": "io.github.gerchanisko.vimmi.beta",
  "build": {
    "frontendDist": "../dist-tauri",
    "devUrl": "http://localhost:5196",
    "beforeDevCommand": "npm run dev:tauri-web",
    "beforeBuildCommand": "npm run build:tauri-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vimmi Beta",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https: vimmi-file: http://vimmi-file.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "category": "Productivity",
    "shortDescription": "Poznámky, úkoly a kalendář s AI",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
