{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Vimmi window may do: its own commands, folder dialogs, opening web links, notifications and HTTPS requests for AI, GitHub sync and calendars.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }]
    },
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://localhost:*" }, { "url": "http://127.0.0.1:*" }]
    }
  ]
}
